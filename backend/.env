# Database Configuration
# Local zero-friction SQLite fallback active for immediate execution.
# To switch to PostgreSQL, uncomment the line below and comment the SQLite line:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rentiq_db?schema=public"
DATABASE_URL="file:./dev.db"

PORT=5000
NODE_ENV=development
JWT_SECRET="rentiq_super_secret_production_key_987654321_jwt_auth"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"
UPLOAD_DIR="uploads"
