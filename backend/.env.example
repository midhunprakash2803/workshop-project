# Database Configuration
# For PostgreSQL (Production / Render / Supabase / Neon):
DATABASE_URL="postgresql://postgres:password@localhost:5432/rentiq_db?schema=public"

# For SQLite (Instant Local Development without Postgres daemon):
# DATABASE_URL="file:./dev.db"

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# JWT Secret & Expiry
JWT_SECRET="rentiq_super_secret_production_key_987654321_jwt_auth"
JWT_EXPIRES_IN="7d"

# Client Application URL (for CORS)
CLIENT_URL="http://localhost:5173"

# Uploads Directory Path
UPLOAD_DIR="uploads"
